# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug and server logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
server*.log

# env files
.env*
!.env.example

# vercel
.vercel

