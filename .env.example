# ResourceX Environment Configuration
# Copy to .env.local (or configure in Vercel / hosting environment variables).
# NEVER commit .env.local or production secrets to source control.

# Required: Cryptographically secure 256-bit secret used to sign session JWTs
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_chars

# Database Configuration (Turso Cloud Database via @libsql/client)
# For local development without Turso, omit or set to: file:data/resourcex.db
# For production (Vercel), provide your Turso database URL and authentication token:
TURSO_DATABASE_URL=libsql://your-database-name-organization.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Storage Configuration (Vercel Blob via @vercel/blob)
# Required on Vercel for serverless photo uploads. Auto-configured when connecting Vercel Blob store.
# For local offline development, omit to use local public/uploads directory.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# Razorpay Payment Gateway (Test Mode)
# Razorpay remains strictly in Test Mode
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
PAYMENT_MODE=test

# Optional: Development-only Seed Demo Accounts (STRICTLY OPT-IN, disabled in production)
# Set to 'true' in development only if you wish to initialize pre-configured demo users
SEED_DEMO_ACCOUNTS=false
DEMO_BORROWER_PASSWORD=your_secure_dev_borrower_password_here
DEMO_OWNER_PASSWORD=your_secure_dev_owner_password_here
DEMO_ADMIN_PASSWORD=your_secure_dev_admin_password_here
