# ResourceX Environment Configuration
# Copy to .env.local and enter your own local credentials.
# NEVER commit .env.local or production secrets to source control.

# Required: Cryptographically secure 256-bit secret used to sign session JWTs
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_chars

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
PAYMENT_MODE=test

# Optional: Development-only Seed Demo Accounts (STRICTLY OPT-IN, disabled in production)
# Set to 'true' in development only if you wish to initialize pre-configured demo users
SEED_DEMO_ACCOUNTS=false
DEMO_BORROWER_PASSWORD=your_secure_dev_borrower_password_here
DEMO_OWNER_PASSWORD=your_secure_dev_owner_password_here
DEMO_ADMIN_PASSWORD=your_secure_dev_admin_password_here
